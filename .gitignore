# Raw and interim data stay local (brief: raw is never committed; hashes are in docs/data_manifest.md).
data/raw/*
data/interim/*
!data/**/.gitkeep
# data/processed (cleaned tables and features) IS committed, except the 233 MB text matrix (regenerate with
# python -m src.features.text, about 1 minute).
data/processed/features/text_svd/
logs/
.ipynb_checkpoints/
__pycache__/
.env
*.csv.gz
venv/
# Never commit the steamid salt, wherever it ends up.
.steamid_salt
